{
  "name": "modellodge",
  "version": "2.5.0",
  "description": "ModelLodge 本地模型管理器 — 下载、管理、显存适配与校验",
  "main": "main.js",
  "author": "ModelLodge Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.modellodge.app",
    "productName": "ModelLodge",
    "copyright": "Copyright © 2026 ModelLodge Team. 保留所有权利。",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "gguf.js",
      "downloader.js",
      "chat.js",
      "websearch.js",
      "document.js",
      "actions.js",
      "software-catalog.js",
      "engine.js",
      "api-server.js",
      "model-check.js",
      "vram.js",
      "brands.js",
      "logger.js",
      "renderer/**/*",
      "icon.png",
      "icon-16.png",
      "THIRD_PARTY_NOTICES.md",
      "GUIDE.md",
      "CHANGELOG.md"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "GUIDE.md",
        "to": "GUIDE.md"
      },
      {
        "from": "LICENSE.rtf",
        "to": "LICENSE.rtf"
      },
      {
        "from": "cli",
        "to": "cli",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/llama",
        "to": "llama",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "ModelLodge-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "license": "LICENSE.rtf",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ModelLodge",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "menuCategory": true,
      "artifactName": "ModelLodge-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "https-proxy-agent": "^5.0.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  }
}
